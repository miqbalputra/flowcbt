[Unit]
Description=FlowCBT API (Go)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/opt/flowcbt/flowcbt.env
ExecStart=/opt/flowcbt/bin/flowcbt-api
WorkingDirectory=/opt/flowcbt
Restart=always
RestartSec=3
User=root
# hardening ringan
NoNewPrivileges=true
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
