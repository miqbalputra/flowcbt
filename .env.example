# FlowCBT backend — environment contoh (salin sbg .env)
HTTP_PORT=8080
APP_ENV=development
DATABASE_URL=postgres://flowcbt:flowcbt_dev@127.0.0.1:5433/flowcbt
DATABASE_APP_URL=postgres://flowcbt_app:app_user_dev@127.0.0.1:5433/flowcbt
JWT_SECRET=ganti-secret-panjang-acak
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
SEED_SUPERADMIN_EMAIL=superadmin@flowcbt.id
SEED_SUPERADMIN_PASS=Admin#12345
UPLOAD_DIR=./data/uploads

# Midtrans (opsional; kosong = mode simulasi checkout)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_ENV=sandbox
# Mayar (opsional)
MAYAR_WEBHOOK_SECRET=
